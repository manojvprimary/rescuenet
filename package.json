{
  "name": "rescuenet",
  "version": "1.0.0",
  "description": "RescueNet \u2014 blackboard multi-agent animal rescue routing",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "diff": "cdk diff --all",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "smoke": "ts-node scripts/smoke-weights.ts",
    "synth": "cdk synth --quiet"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.21.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-eventbridge": "^3.600.0",
    "@aws-sdk/client-location": "^3.600.0",
    "@aws-sdk/client-rekognition": "^3.600.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  },
  "engines": {
    "node": ">=20 <21"
  }
}
